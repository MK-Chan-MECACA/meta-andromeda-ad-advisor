# Pull provisioned values with: vercel env pull .env.local

# Neon (Vercel Marketplace)
DATABASE_URL=

# Clerk (Vercel Marketplace or dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Stripe (MYR prices)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Vercel Blob (private store)
BLOB_READ_WRITE_TOKEN=

# AI Gateway: OIDC on Vercel; locally VERCEL_OIDC_TOKEN via vercel env pull (or AI_GATEWAY_API_KEY)
MODEL_PRO=spacexai/grok-4.7
MODEL_FREE=anthropic/claude-haiku-5.5

# Meta ad import (Facebook Login for Business + Marketing API)
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
# Optional — defaults to <current origin>/api/meta/callback
META_REDIRECT_URI=
# AES-256-GCM key for stored Meta tokens: openssl rand -base64 32
META_TOKEN_KEY=
GRAPH_API_VERSION=v25.0
