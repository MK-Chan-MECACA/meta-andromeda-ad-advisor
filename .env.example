# Get a key from https://console.x.ai/
XAI_API_KEY=xai-your-key-here

# Meta ad import (Facebook Login for Business + Marketing API)
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
# Optional — defaults to <current origin>/api/meta/callback
# Production: https://meta-andromeda-ad-advisor.vercel.app/api/meta/callback
META_REDIRECT_URI=
# openssl rand -hex 32
SESSION_SECRET=
GRAPH_API_VERSION=v25.0

# Analyze API abuse controls (optional)
# ANALYZE_RATE_LIMIT_PER_MIN=5
# Max concurrent analyze jobs per server isolate (default 2)
# ANALYZE_MAX_IN_FLIGHT=2
# Comma-separated extra Origins allowed to call /api/analyze (same-origin always ok)
# ANALYZE_ALLOWED_ORIGINS=https://andromeda.mecaca.global
# Allow non-browser clients that omit Origin / Sec-Fetch-Site (default off)
# ANALYZE_ALLOW_MISSING_ORIGIN=1
